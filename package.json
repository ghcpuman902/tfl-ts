{
  "name": "tfl-ts",
  "version": "2.13.0",
  "description": "Typed TypeScript client for the Transport for London API: friendly wrappers, full raw coverage, static station sequences, and UI helpers for official line colours.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "bin": {
    "tfl": "./dist/cjs/bin/tfl.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./ui": {
      "types": "./dist/cjs/ui.d.ts",
      "import": "./dist/esm/ui.js",
      "require": "./dist/cjs/ui.js"
    },
    "./meta": {
      "types": "./dist/cjs/meta.d.ts",
      "import": "./dist/esm/meta.js",
      "require": "./dist/cjs/meta.js"
    },
    "./utils/ui": {
      "types": "./dist/cjs/utils/ui.d.ts",
      "import": "./dist/esm/utils/ui.js",
      "require": "./dist/cjs/utils/ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/agent.md",
    "docs/mcp.md",
    "docs/MIGRATION-v2.md",
    "docs/REALTIME.md",
    "docs/design/",
    "examples/",
    "CHANGELOG.md",
    "CLAUDE.md",
    "AGENTS.md",
    "ERROR.md",
    ".claude/"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && ts-node script/writeDistModuleType.ts",
    "measure:bundle": "ts-node script/measureBundle.ts",
    "test": "jest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "sync:spec": "ts-node script/syncSpec.ts",
    "generate": "ts-node script/generate.ts",
    "check": "ts-node script/check.ts",
    "demo": "ts-node script/demo.ts",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run test && pnpm run check && pnpm run build"
  },
  "keywords": [
    "tfl",
    "transport-for-london",
    "typescript",
    "api",
    "client",
    "london",
    "tube",
    "bus",
    "arrivals",
    "journey-planning",
    "openapi",
    "mcp",
    "zero-dependencies",
    "sdk"
  ],
  "author": "Mangle Kuo <manglekuo@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghcpuman902/tfl-ts.git"
  },
  "bugs": {
    "url": "https://github.com/ghcpuman902/tfl-ts/issues"
  },
  "homepage": "https://github.com/ghcpuman902/tfl-ts#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "dotenv": "^17.4.2",
    "esbuild": "0.25.9",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "swagger-typescript-api": "13.12.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/helpers": "^7.26.10",
      "brace-expansion@^1": "1.1.12",
      "brace-expansion@^2": "^2.0.2",
      "diff": "^4.0.4",
      "flatted": "^3.4.2",
      "js-yaml": "^4.1.1",
      "minimatch": "^9.0.6",
      "picomatch": "^4.0.4",
      "yaml": "^2.8.3"
    }
  }
}
